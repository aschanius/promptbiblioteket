---
import Base from '../layouts/Base.astro';
import PromptCard from '../components/PromptCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/categories';
import { levelLabels } from '../lib/flows';
import { themes } from '../lib/themes';
import PromptCount from '../components/PromptCount.astro';

const allPrompts = await getCollection('prompts');
const allFlows = await getCollection('flows');
const flows = [...allFlows].sort((a, b) => a.data.title.localeCompare(b.data.title, 'sv'));

// Count prompts per category
const countByCategory = new Map<string, number>();
for (const p of allPrompts) {
  const cat = p.data.category;
  countByCategory.set(cat, (countByCategory.get(cat) || 0) + 1);
}

// Latest prompts (sorted by tested_date desc)
const latestPrompts = [...allPrompts]
  .filter(p => p.data.tested_date)
  .sort((a, b) => (b.data.tested_date!.getTime() - a.data.tested_date!.getTime()))
  .slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Promptbiblioteket',
  url: 'https://prompts.teknikministeriet.se',
  description: 'Open source AI-prompts för svenska yrkesverksamma',
  publisher: {
    '@type': 'Organization',
    name: 'Teknikministeriet',
    url: 'https://teknikministeriet.se',
  },
};
---
<Base
  title="Promptbiblioteket"
  description="Open source AI-prompts för svenska yrkesverksamma. Sök, kopiera och använd — gratis."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <div class="text-center mb-12 mt-4">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">Promptbiblioteket</h1>
    <p class="text-lg mb-2" style="color: var(--tm-muted);">
      AI-prompts för svenska yrkesverksamma. Sök, kopiera, använd.
    </p>
    <PromptCount class="text-sm" />
  </div>

  <style>
    :global(.count-num) { color: var(--color-tm-accent); }
  </style>

  <!-- Pagefind search (index skapas vid npm run build) -->
  <div id="search" class="max-w-xl mx-auto mb-12"></div>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI !== 'undefined') {
        var pf = new PagefindUI({
          element: '#search',
          showSubResults: false,
          showImages: false,
          translations: {
            placeholder: 'Sök bland prompts...',
            zero_results: 'Inga träffar för [SEARCH_TERM]',
          },
        });
        // Stöd ?q= från Ghost-söket
        var q = new URLSearchParams(location.search).get('q');
        if (q) {
          var input = document.querySelector('#search input');
          if (input) { input.value = q; pf.triggerSearch(q); }
        }
      } else {
        var el = document.getElementById('search');
        var p = document.createElement('p');
        p.style.cssText = 'text-align:center;color:var(--tm-muted);font-size:0.875rem';
        p.textContent = 'Sök tillgänglig efter npm run build + npm run preview';
        el.appendChild(p);
      }
    });
  </script>
  <style>
    /* Override Pagefind UI theme to match TM brand */
    :root {
      --pagefind-ui-scale: 0.9;
      --pagefind-ui-primary: #00D4AA;
      --pagefind-ui-text: #111827;
      --pagefind-ui-background: #f9fafb;
      --pagefind-ui-border: #e5e7eb;
      --pagefind-ui-tag: #e5e7eb;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 0.5rem;
      --pagefind-ui-font: system-ui, -apple-system, sans-serif;
    }
    :root.dark {
      --pagefind-ui-text: #f1f5f9;
      --pagefind-ui-background: #242424;
      --pagefind-ui-border: #333333;
      --pagefind-ui-tag: #333333;
    }
  </style>

  <!-- Category grid -->
  <section class="mb-16">
    <h2 class="text-xl font-semibold mb-6">Kategorier</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {categories.map(cat => {
        const count = countByCategory.get(cat.id) || 0;
        return (
          <a href={`/${cat.id}/`} class="category-card block no-underline" style="color: var(--tm-text);">
            <h3 class="font-semibold mb-1">{cat.title}</h3>
            <p class="text-sm mb-2" style="color: var(--tm-muted);">{cat.description}</p>
            <span class="text-xs font-mono" style="color: var(--color-tm-accent);">
              {count} {count === 1 ? 'prompt' : 'prompts'}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Flows -->
  {flows.length > 0 && (
    <section class="mb-16">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-xl font-semibold">Flöden</h2>
        <a href="/flode/" class="text-sm hover:underline" style="color: var(--color-tm-accent);">Alla flöden →</a>
      </div>
      <p class="text-sm mb-4" style="color: var(--tm-muted);">
        Kedjor av prompts som löser större arbetsuppgifter — från månadsbokslut till rekryteringsprocess.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {flows.slice(0, 6).map(flow => (
          <a href={`/flode/${flow.data.slug}/`} class="prompt-card block no-underline" style="color: var(--tm-text);">
            <h3 class="text-base font-semibold mb-2">{flow.data.title}</h3>
            <div class="flex flex-wrap gap-3 text-xs" style="color: var(--tm-muted);">
              {flow.data.estimated_time && <span>⏱ {flow.data.estimated_time}</span>}
              {flow.data.level && <span>{levelLabels[flow.data.level]}</span>}
              <span>{flow.data.steps.length} steg</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Themes -->
  {themes.length > 0 && (
    <section class="mb-16">
      <h2 class="text-xl font-semibold mb-6">Teman</h2>
      <p class="text-sm mb-4" style="color: var(--tm-muted);">
        Tvärs yrkeskategorier — när ett ämne behöver samverkan mellan roller.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {themes.map(theme => (
          <a href={`/tema/${theme.id}/`} class="prompt-card block no-underline" style="color: var(--tm-text);">
            <h3 class="text-base font-semibold mb-2">{theme.title}</h3>
            <p class="text-sm" style="color: var(--tm-muted);">{theme.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Latest prompts -->
  {latestPrompts.length > 0 && (
    <section>
      <h2 class="text-xl font-semibold mb-6">Senast tillagda</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {latestPrompts.map(p => (
          <PromptCard
            title={p.data.title}
            href={`/${p.data.category}/${p.data.slug}/`}
            tags={p.data.tags}
            testedDate={p.data.tested_date}
          />
        ))}
      </div>
    </section>
  )}
</Base>
