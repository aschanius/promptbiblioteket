{
  "name": "promptbiblioteket",
  "version": "1.0.0",
  "description": "Open source AI-prompts för svenska yrkesverksamma",
  "private": true,
  "scripts": {
    "verify": "node pipeline/verify-prompts.js",
    "format": "node pipeline/4-publish/format-prompt.js",
    "manifest": "node pipeline/4-publish/update-manifest.js",
    "generate": "node pipeline/generate-prompt.js",
    "pipeline": "node pipeline/run-pipeline.js",
    "build": "npm run verify && cd site && npm run build",
    "dev": "cd site && npm run dev",
    "preview": "cd site && npm run preview"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "yaml": "^2.4.0"
  },
  "license": "MIT",
  "author": "Magnus Aschan <magnus@teknikministeriet.se>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aschanius/promptbiblioteket"
  }
}
